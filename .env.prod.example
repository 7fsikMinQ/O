# 운영 서버에만 .env.prod 로 둔다(권한 600, 저장소·이미지에 포함 ✕). 18번 문서.
DB_SUPERUSER=app
DB_SUPERUSER_PASSWORD=
DB_USER=app
DB_PASSWORD=
BACKEND_IMAGE=bojohelp-backend:YYYYMMDD-gitsha
API_DOMAIN=api.example.com
CORS_ALLOWED_ORIGINS=https://company.example.com
SMTP_HOST=                  # 예: smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=                  # 예: no-reply@내도메인 (SPF·DKIM·DMARC 등록 필수)
WEB_BASE_URL=               # 업체 웹 주소(메일 속 링크)
ADMIN_EMAIL=               # 최초 관리자(첫 기동 때 1회 생성). 오픈 전 관리자 2차 인증(TOTP) 추가 필수
ADMIN_PASSWORD=             # 10자 이상, 영문+숫자. 첫 로그인 후 즉시 변경 기능 추가 예정
JWT_SIGNING_KEY=            # 32바이트 이상 무작위
HMAC_PEPPER=                # 16자 이상 무작위(전화번호·인증번호·토큰 해시용)
SMS_PROVIDER=               # 문자 대행사 구현 추가 후 지정(console 은 운영 불가)
FIELD_ENCRYPTION_KEY_V1=
FIELD_ENCRYPTION_ACTIVE_VERSION=1
