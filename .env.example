# 복사해서 .env 로 사용 (절대 커밋 금지). 운영 값은 서버/CI 시크릿에만 둔다.
# ── DB
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASSWORD=app
# ── 스토리지 (개발: MinIO, 운영: Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET_PRIVATE=app-private
S3_BUCKET_PUBLIC=app-public
CDN_BASE_URL=http://localhost:9000/app-public
# ── 보안 (운영은 반드시 새로 생성)
JWT_SIGNING_KEY=change-me-32bytes-min
FIELD_ENCRYPTION_KEY_V1=base64-32byte-key     # AES-256-GCM, key_version=1
FIELD_ENCRYPTION_ACTIVE_VERSION=1
# ── 외부 연동
FCM_SERVICE_ACCOUNT_JSON_PATH=./secrets/fcm.json
MAIL_PROVIDER=smtp                              # smtp(개발: mailpit) | resend | ses
SMTP_HOST=localhost
SMTP_PORT=1025
KAKAO_REST_API_KEY=
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
TURNSTILE_SECRET=
# ── 앱 설정
APP_TIMEZONE=Asia/Seoul
SPRING_PROFILES_ACTIVE=local
